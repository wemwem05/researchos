# ResearchOS local configuration. Copy to .env (never commit it):
#   cp .env.example .env
#
# PDF analysis / localization (Meta Model API).
MODEL_API_KEY=
# MODEL_BASE_URL=https://api.meta.ai/v1  # only if yours differs
# RESEARCHOS_MODEL=muse-spark-1.3         # only to override the default

# Agentic research workflows (investigator/critic, audits, discovery),
# served by Baseten with the EXACT model id:
#   meta-models/muse-spark-open-1026
BASETEN_API_KEY=

# Optional: literature discovery works keyless, but a key raises OpenAlex
# rate limits and joins the polite pool.
OPENALEX_API_KEY=
# Recommended contact address for the OpenAlex polite pool (read as
# OPENALEX_MAILTO by prototype/openalex.py).
OPENALEX_MAILTO=

# Optional: PDF upload guardrails (defaults: 32 MB, 60 pages).
# RESEARCHOS_MAX_PDF_MB=32
# RESEARCHOS_MAX_PDF_PAGES=60

# Optional: computational verification runs on Modal (or `modal token new`
# for a CLI profile). Without credentials the app shows verification as
# unavailable instead of failing.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
